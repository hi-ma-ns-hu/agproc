# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=DEVELOPMENT
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agproc

# ── Tracing ────────────────────────────────────────
TRACELOOP_API_ENDPOINT=http://localhost:4318

# ── MODEL ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here